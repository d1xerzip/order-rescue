    { "name": "unavailable money does not hide quantity match", "shop": "A", "order": "98005", "revision": 1, "amount": null, "currency": "CAD", "quantities": [6], "expected": { "value": "unknown", "quantity": "matched", "valueReason": "AMOUNT_UNAVAILABLE", "quantityReason": "ABOVE_THRESHOLD", "exceptions": ["high_line_quantity"], "matchingLines": [{ "id": "gid://shopify/LineItem/501", "currentQuantity": 6 }] } },
    { "name": "unavailable lines do not hide value match", "shop": "A", "order": "98006", "revision": 1, "amount": "100.01", "currency": "CAD", "quantities": null, "expected": { "value": "matched", "quantity": "unknown", "valueReason": "ABOVE_THRESHOLD", "quantityReason": "LINES_UNAVAILABLE", "exceptions": ["high_order_value"] } },
