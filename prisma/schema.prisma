generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Session {
  id String @id
  shop String
  state String
  isOnline Boolean @default(false)
  scope String?
  expires DateTime?
  accessToken String
  userId BigInt?
  firstName String?
  lastName String?
  email String?
  accountOwner Boolean @default(false)
  locale String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
  refreshToken String?
  refreshTokenExpires DateTime?
  @@index([shop])
}

model Shop {
  id String @id @default(uuid())
  domain String @unique
  shopifyId String? @unique
  active Boolean @default(true)
  generation Int @default(1)
  installedAt DateTime @default(now())
  uninstalledAt DateTime?
  jobsEnabled Boolean @default(true)
  workspaceRecord WorkspaceRecord?
  orderJobs OrderJob[]
  orderSnapshots OrderSnapshot[]
  orderSync OrderSyncState?
  orderReadLocks OrderReadLock[]
  ruleSettings RuleSetting[]
}

model OrderReadLock {
  shopId String
  generation Int
  orderId String
  token String
  expiresAt DateTime
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@id([shopId, generation, orderId])
  @@index([expiresAt])
}

model OrderSyncState {
  shopId String @id
  generation Int
  phase String @default("idle")
  runId String?
  windowStart DateTime?
  windowEnd DateTime?
  cursor String?
  pageNo Int @default(0)
  pendingCursor String?
  pendingHasNextPage Boolean @default(false)
  pendingJobIds Json @default("[]")
  lastSuccessAt DateTime?
  nextRunAt DateTime
  lastError String?
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

enum OrderJobStatus {
  pending
  processing
  completed
  retry
  failed
}

model OrderJob {
  id String @id @default(uuid())
  shopId String
  generation Int
  deliveryId String
  orderId String
  minimumUpdatedAt DateTime?
  status OrderJobStatus @default(pending)
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  availableAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  receivedAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  expiresAt DateTime
  errorCode String?
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, generation, deliveryId])
  @@index([status, availableAt, leaseUntil])
  @@index([expiresAt])
}

model OrderSnapshot {
  id String @id @default(uuid())
  shopId String
  generation Int
  orderId String
  evaluations RuleEvaluation[]
  exceptions ExceptionRecord[]
  encryptedSnapshot String
  orderCreatedAt DateTime
  orderUpdatedAt DateTime
  expiresAt DateTime
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, generation, orderId])
  @@index([expiresAt])
}

model WorkspaceRecord {
  id String @id @default(uuid())
  shopId String @unique
  displayName String @default("Order Rescue")
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model LifecycleDelivery {
  id String @id @default(uuid())
  shopDomain String
  deliveryId String
  receivedAt DateTime @default(now())
  triggeredAt DateTime?
  @@unique([shopDomain, deliveryId])
}

model PrivacyReceipt {
  id String @id @default(uuid())
  shopDomain String
  topic String
  deliveryId String
  payload Json
  status String @default("pending")
  receivedAt DateTime @default(now())
  attempts Int @default(0)
  availableAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  leaseToken String?
  leaseUntil DateTime?
  completedAt DateTime?
  errorCode String?
  encryptedExport String?
  exportExpiresAt DateTime?
  deliveredAt DateTime?
  encryptedDelivery String?
  @@index([status, availableAt, leaseUntil])
  @@unique([shopDomain, topic, deliveryId])
}

// Keyed routing hashes only; never customer profiles or erased evidence.
model PrivacyDeletion {
  shopKey String
  orderKey String
  deletedAt DateTime
  @@id([shopKey, orderKey])
}
model RuleSetting {
  shopId String
  generation Int
  ruleKey String
  revision Int
  settingsVersion String
  encryptedSettings String
  updatedAt DateTime
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@id([shopId, generation, ruleKey])
}

model RuleEvaluation {
  id String @id @default(uuid())
  shopId String
  generation Int
  orderId String
  ruleKey String
  fingerprint String
  encryptedResult String
  checkedAt DateTime
  snapshot OrderSnapshot @relation(fields: [shopId, generation, orderId], references: [shopId, generation, orderId], onDelete: Cascade)
  @@unique([shopId, generation, orderId, ruleKey])
}

enum ExceptionState {
  open
  acknowledged
  resolved
  ignored
}

model ExceptionRecord {
  id String @id @default(uuid())
  shopId String
  generation Int
  orderId String
  ruleKey String
  state ExceptionState @default(open)
  revision Int @default(1)
  createdAt DateTime
  updatedAt DateTime
  snapshot OrderSnapshot @relation(fields: [shopId, generation, orderId], references: [shopId, generation, orderId], onDelete: Cascade)
  history ExceptionHistory[]
  @@unique([shopId, orderId, ruleKey])
  @@index([shopId, generation, state])
}

model ExceptionHistory {
  id String @id @default(uuid())
  exceptionId String
  revision Int
  kind String
  at DateTime
  encryptedDetail String
  exception ExceptionRecord @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  @@index([exceptionId, at])
  @@unique([exceptionId, revision])
}
