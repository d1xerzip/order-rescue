generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Session {
  id String @id
  shop String
  state String
  isOnline Boolean @default(false)
  scope String?
  expires DateTime?
  accessToken String
  userId BigInt?
  firstName String?
  lastName String?
  email String?
  accountOwner Boolean @default(false)
  locale String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
  refreshToken String?
  refreshTokenExpires DateTime?
  @@index([shop])
}

model Shop {
  id String @id @default(uuid())
  domain String @unique
  shopifyId String? @unique
  active Boolean @default(true)
  generation Int @default(1)
  installedAt DateTime @default(now())
  uninstalledAt DateTime?
  jobsEnabled Boolean @default(true)
  workspaceRecord WorkspaceRecord?
  orderJobs OrderJob[]
  orderSnapshots OrderSnapshot[]
}

enum OrderJobStatus {
  pending
  processing
  completed
  retry
  failed
}

model OrderJob {
  id String @id @default(uuid())
  shopId String
  generation Int
  deliveryId String
  orderId String
  status OrderJobStatus @default(pending)
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  availableAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  receivedAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  expiresAt DateTime
  errorCode String?
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, generation, deliveryId])
  @@index([status, availableAt, leaseUntil])
  @@index([expiresAt])
}

model OrderSnapshot {
  id String @id @default(uuid())
  shopId String
  generation Int
  orderId String
  encryptedSnapshot String
  orderCreatedAt DateTime
  orderUpdatedAt DateTime
  expiresAt DateTime
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, generation, orderId])
  @@index([expiresAt])
}

model WorkspaceRecord {
  id String @id @default(uuid())
  shopId String @unique
  displayName String @default("Order Rescue")
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model LifecycleDelivery {
  id String @id @default(uuid())
  shopDomain String
  deliveryId String
  receivedAt DateTime @default(now())
  triggeredAt DateTime?
  @@unique([shopDomain, deliveryId])
}

model PrivacyReceipt {
  id String @id @default(uuid())
  shopDomain String
  topic String
  deliveryId String
  payload Json
  status String @default("pending")
  receivedAt DateTime @default(now())
  @@unique([shopDomain, topic, deliveryId])
}
